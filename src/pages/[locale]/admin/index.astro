---
import Layout from '@/components/Layout.astro';
import { getPageContent } from '@/lib/site';
import { normalizeLocale } from '@/lib/i18n';
import { getMarkupPercent } from '@/server/settings';
import { getPool } from '@/server/db';

const locale = normalizeLocale(Astro.params.locale);
const currency = Astro.locals.currency;
const content = getPageContent(locale);
const ronRate = Astro.locals.ronRate;
const markupPercent = await getMarkupPercent();

const status = Astro.url.searchParams.get('status');
const error = Astro.url.searchParams.get('error');

// Fetch users and clients from DB
const pool = getPool();
let users: any[] = [];
let clients: any[] = [];

if (pool) {
	const [usersResult, clientsResult] = await Promise.all([
		pool.query(`
			SELECT id, email, first_name, last_name, role, status, last_login_at, created_at
			FROM users
			WHERE deleted_at IS NULL
			ORDER BY created_at DESC
		`),
		pool.query(`
			SELECT id, email, first_name, last_name, company_name, status, client_group, currency, last_login_at, created_at
			FROM customers
			ORDER BY created_at DESC
		`),
	]);
	users = usersResult.rows;
	clients = clientsResult.rows;
}

function fmtDate(d: string | null) {
	if (!d) return '—';
	return new Date(d).toLocaleDateString('ro-RO', { day: '2-digit', month: '2-digit', year: 'numeric' });
}
---

<Layout locale={locale} currency={currency} title="Admin | VIP Super Hosting" description="Admin panel" path={Astro.url.pathname} user={Astro.locals.user}>
	<section class="section">
		<div class="container">
			<h1 style="margin-bottom: 2rem;">Admin Panel</h1>

			{status && <div class="notice notice--success" style="margin-bottom: 1.5rem;">{status.replaceAll('-', ' ')}</div>}
			{error && <div class="notice notice--error" style="margin-bottom: 1.5rem;">{error.replaceAll('-', ' ')}</div>}

			<!-- Settings cards -->
			<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2.5rem;">

				<!-- Exchange rate -->
				<div class="account-card form-grid">
					<p class="acct-section-title">Rata de schimb EUR → RON</p>
					<p style="font-size: 0.85rem; color: var(--muted); margin-bottom: 1rem;">
						Curent: <strong>1 EUR = {ronRate.toFixed(4)} RON</strong>
					</p>
					<form method="post" action="/api/admin/exchange-rate">
						<div class="field" style="margin-bottom: 1rem;">
							<label for="ronRate">Rata nouă (RON per EUR)</label>
							<input class="input" id="ronRate" name="ronRate" type="number" step="0.0001" min="1" max="100" value={ronRate.toFixed(4)} required />
						</div>
						<button class="button button--primary button--sm" type="submit">Salvează rata</button>
					</form>
				</div>

				<!-- Hetzner markup -->
				<div class="account-card form-grid">
					<p class="acct-section-title">Markup Hetzner VPS</p>
					<p style="font-size: 0.85rem; color: var(--muted); margin-bottom: 1rem;">
						Curent: <strong>{markupPercent.toFixed(2)}% peste prețul net Hetzner</strong>
					</p>
					<form method="post" action="/api/admin/markup">
						<div class="field" style="margin-bottom: 1rem;">
							<label for="markupPercent">Markup nou (%)</label>
							<input class="input" id="markupPercent" name="markupPercent" type="number" step="0.01" min="0" max="500" value={markupPercent.toFixed(2)} required />
						</div>
						<button class="button button--primary button--sm" type="submit">Salvează markup</button>
					</form>
				</div>

			</div>

			<!-- Users table -->
			<div class="account-card" style="margin-bottom: 2rem;">
				<p class="acct-section-title" style="margin-bottom: 1rem;">Utilizatori panel ({users.length})</p>
				<div class="table-card">
					<table class="table">
						<thead>
							<tr>
								<th>Nume</th>
								<th>Email</th>
								<th>Rol</th>
								<th>Status</th>
								<th>Ultima logare</th>
								<th>Creat</th>
							</tr>
						</thead>
						<tbody>
							{users.length ? users.map((u) => (
								<tr>
									<td>{u.first_name} {u.last_name}</td>
									<td>{u.email}</td>
									<td><span class="badge" style="font-size:0.75rem;">{u.role}</span></td>
									<td><span class:list={['status-pill', u.status === 'active' && 'status-pill--active']}>{u.status}</span></td>
									<td style="font-size:0.82rem; color:var(--muted);">{fmtDate(u.last_login_at)}</td>
									<td style="font-size:0.82rem; color:var(--muted);">{fmtDate(u.created_at)}</td>
								</tr>
							)) : (
								<tr><td colspan="6" style="text-align:center; color:var(--muted);">Niciun utilizator</td></tr>
							)}
						</tbody>
					</table>
				</div>
			</div>

			<!-- Clients table -->
			<div class="account-card">
				<p class="acct-section-title" style="margin-bottom: 1rem;">Clienți ({clients.length})</p>
				<div class="table-card">
					<table class="table">
						<thead>
							<tr>
								<th>Nume / Companie</th>
								<th>Email</th>
								<th>Grup</th>
								<th>Valuta</th>
								<th>Status</th>
								<th>Ultima logare</th>
								<th>Creat</th>
							</tr>
						</thead>
						<tbody>
							{clients.length ? clients.map((c) => (
								<tr>
									<td>
										<div>{c.first_name} {c.last_name}</div>
										{c.company_name && <div style="font-size:0.8rem; color:var(--muted);">{c.company_name}</div>}
									</td>
									<td>{c.email}</td>
									<td style="font-size:0.82rem;">{c.client_group || '—'}</td>
									<td style="font-size:0.82rem;">{c.currency || '—'}</td>
									<td><span class:list={['status-pill', c.status === 'active' && 'status-pill--active']}>{c.status}</span></td>
									<td style="font-size:0.82rem; color:var(--muted);">{fmtDate(c.last_login_at)}</td>
									<td style="font-size:0.82rem; color:var(--muted);">{fmtDate(c.created_at)}</td>
								</tr>
							)) : (
								<tr><td colspan="7" style="text-align:center; color:var(--muted);">Niciun client</td></tr>
							)}
						</tbody>
					</table>
				</div>
			</div>

		</div>
	</section>
</Layout>

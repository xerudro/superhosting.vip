---
import Layout from '@/components/Layout.astro';
import { getPageContent } from '@/lib/site';
import { normalizeLocale } from '@/lib/i18n';

const locale = normalizeLocale(Astro.params.locale);
const currency = Astro.locals.currency;
const content = getPageContent(locale);
const ronRate = Astro.locals.ronRate;

const status = Astro.url.searchParams.get('status');
const error = Astro.url.searchParams.get('error');
---

<Layout locale={locale} currency={currency} title="Admin | VIP Super Hosting" description="Admin panel" path={Astro.url.pathname} user={Astro.locals.user}>
	<section class="section">
		<div class="container" style="max-width: 640px;">
			<h1 style="margin-bottom: 2rem;">Admin</h1>

			{status && <div class="notice notice--success" style="margin-bottom: 1rem;">{status.replaceAll('-', ' ')}</div>}
			{error && <div class="notice notice--error" style="margin-bottom: 1rem;">{error.replaceAll('-', ' ')}</div>}

			<div class="account-card form-grid">
				<p class="acct-section-title">Rata de schimb EUR → RON</p>
				<p style="font-size: 0.85rem; color: var(--muted); margin-bottom: 1rem;">
					Rata curentă: <strong>1 EUR = {ronRate.toFixed(4)} RON</strong>
				</p>
				<form method="post" action="/api/admin/exchange-rate">
					<div class="field" style="margin-bottom: 1rem;">
						<label for="ronRate">Rata nouă (RON per EUR)</label>
						<input
							class="input"
							id="ronRate"
							name="ronRate"
							type="number"
							step="0.0001"
							min="1"
							max="100"
							value={ronRate.toFixed(4)}
							required
						/>
					</div>
					<button class="button button--primary button--sm" type="submit">Salvează rata</button>
				</form>
			</div>
		</div>
	</section>
</Layout>

---
import Layout from '@/components/Layout.astro';
import { brand, getPageContent } from '@/lib/site';
import { normalizeLocale } from '@/lib/i18n';

const locale = normalizeLocale(Astro.params.locale);
const currency = Astro.locals.currency;
const content = getPageContent(locale);
---

<Layout locale={locale} currency={currency} title={`${content.about.title} | VIP Super Hosting`} description={content.about.description} path={Astro.url.pathname} user={Astro.locals.user}>
	<section class="section">
		<div class="container split">
			<div class="card stack">
				<span class="eyebrow">About</span>
				<h1>{content.about.title}</h1>
				<p>{content.about.description}</p>
			</div>
			<div class="card stack">
				<h3>Why this positioning works</h3>
				<p>{brand.name} is designed as a small-business friendly technical partner: hosting, operations and web presence without the overhead of fragmented suppliers.</p>
				<ul class="list-clean">
					<li>Localized public experience in RO / EN / DE</li>
					<li>Companion account layer linked to the future control panel</li>
					<li>Fast-loading marketing pages with minimal client-side code</li>
				</ul>
			</div>
		</div>
	</section>
</Layout>

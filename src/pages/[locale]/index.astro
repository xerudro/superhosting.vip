---
import ComparisonTable from '@/components/ComparisonTable.astro';
import FAQList from '@/components/FAQList.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import HeroSection from '@/components/HeroSection.astro';
import Layout from '@/components/Layout.astro';
import PricingCards from '@/components/PricingCards.astro';
import { comparisonRowsByLocale, getFaq, getPageContent, getSharedPlans, getVpsPlans } from '@/lib/site';
import { normalizeLocale, withLocale } from '@/lib/i18n';

const locale = normalizeLocale(Astro.params.locale);
const currency = Astro.locals.currency;
const content = getPageContent(locale);
---

<Layout locale={locale} currency={currency} title={`${content.home.title} | VIP Super Hosting`} description={content.home.description} path={Astro.url.pathname} user={Astro.locals.user}>
	<HeroSection
		locale={locale}
		eyebrow={content.home.eyebrow}
		title={content.home.title}
		description={content.home.description}
		primary={{ href: withLocale(locale, '/shared-hosting'), label: content.home.primaryCta }}
		secondary={{ href: withLocale(locale, '/contact'), label: content.home.secondaryCta }}
		stats={content.home.stats}
	/>
	<FeatureGrid eyebrow="Services" title={content.home.featureIntro} description={content.home.description} items={content.home.features} />
	<PricingCards title="Shared hosting plans" description={content.shared.description} plans={getSharedPlans(locale)} currency={currency} />
	<PricingCards title="VPS hosting plans" description={content.vps.description} plans={getVpsPlans(locale)} currency={currency} />
	<ComparisonTable title="Choose the right platform" description="Compare the two service families before requesting a tailored recommendation." rows={comparisonRowsByLocale[locale]} />
	<FAQList title="Frequently asked questions" description="Short answers for the most common commercial questions." items={getFaq(locale)} />
</Layout>

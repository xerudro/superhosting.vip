---
import ComparisonTable from '@/components/ComparisonTable.astro';
import FAQList from '@/components/FAQList.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import HeroSection from '@/components/HeroSection.astro';
import Layout from '@/components/Layout.astro';
import PriceDisclaimer from '@/components/PriceDisclaimer.astro';
import PricingCards from '@/components/PricingCards.astro';
import { comparisonRowsByLocale, getFaq, getPageContent } from '@/lib/site';
import { normalizeLocale, withLocale } from '@/lib/i18n';
import { getSharedPlansFromDb, getVpsPlansFromDb, getManagedPlansFromDb } from '@/server/plans';

const locale = normalizeLocale(Astro.params.locale);
const currency = Astro.locals.currency;
const content = getPageContent(locale);

const [sharedPlans, vpsPlans, managedPlans] = await Promise.all([
	getSharedPlansFromDb(locale),
	getVpsPlansFromDb(locale),
	getManagedPlansFromDb(locale),
]);
---

<Layout locale={locale} currency={currency} title={`${content.home.title} | VIP Super Hosting`} description={content.home.description} path={Astro.url.pathname} user={Astro.locals.user}>
	<HeroSection
		locale={locale}
		eyebrow={content.home.eyebrow}
		title={content.home.title}
		description={content.home.description}
		primary={{ href: withLocale(locale, '/shared-hosting'), label: content.home.primaryCta }}
		secondary={{ href: withLocale(locale, '/contact'), label: content.home.secondaryCta }}
		stats={content.home.stats}
	/>
	<FeatureGrid eyebrow={content.home.servicesEyebrow} title={content.home.featureIntro} description={content.home.description} items={content.home.features} />
	<PricingCards title={content.shared.tiersTitle} description={content.shared.description} plans={sharedPlans} currency={currency} ronRate={Astro.locals.ronRate} />
	<PricingCards title={content.vps.tiersTitle} description={content.vps.description} plans={vpsPlans} currency={currency} ronRate={Astro.locals.ronRate} />
	<PricingCards title={content.shared.managedTitle} description={content.managed.description} plans={managedPlans} currency={currency} ronRate={Astro.locals.ronRate} />
	<ComparisonTable title={content.home.comparisonTitle} description={content.home.comparisonDescription} rows={comparisonRowsByLocale[locale]} />
	<FAQList title={content.home.faqTitle} description={content.home.faqDescription} items={getFaq(locale)} />
	<PriceDisclaimer locale={locale} />
</Layout>

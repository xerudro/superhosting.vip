---
import Configurator from '@/components/Configurator.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import Layout from '@/components/Layout.astro';
import PricingCards from '@/components/PricingCards.astro';
import { getPageContent, getServiceFeatures } from '@/lib/site';
import { normalizeLocale } from '@/lib/i18n';
import { getVpsPlansFromDb } from '@/server/plans';

const locale = normalizeLocale(Astro.params.locale);
const currency = Astro.locals.currency;
const content = getPageContent(locale);
const vpsPlans = await getVpsPlansFromDb(locale);
---

<Layout locale={locale} currency={currency} title={`${content.vps.title} | VIP Super Hosting`} description={content.vps.description} path={Astro.url.pathname} user={Astro.locals.user}>
	<section class="section hero">
		<div class="container split">
			<div class="card stack">
				<span class="eyebrow">VPS Hosting</span>
				<h1>{content.vps.title}</h1>
				<p>{content.vps.description}</p>
			</div>
			<div class="card">
				<ul class="list-clean">
					{content.vps.highlights.map((item: string) => <li>{item}</li>)}
				</ul>
			</div>
		</div>
	</section>
	<FeatureGrid title={content.vps.featureTitle} description={content.vps.description} items={getServiceFeatures(locale).vps} />
	<PricingCards title={content.vps.tiersTitle} description={content.vps.tiersDescription} plans={vpsPlans} currency={currency} anchor="plans" />
	<Configurator id="configurator" title={content.vps.configuratorTitle} description={content.vps.configuratorDescription} type="vps-config" locale={locale} />
</Layout>

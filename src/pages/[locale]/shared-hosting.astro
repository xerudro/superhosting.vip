---
import Configurator from '@/components/Configurator.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import Layout from '@/components/Layout.astro';
import PricingCards from '@/components/PricingCards.astro';
import { getPageContent, getServiceFeatures } from '@/lib/site';
import { normalizeLocale } from '@/lib/i18n';
import { getSharedPlansFromDb, getManagedPlansFromDb } from '@/server/plans';

const locale = normalizeLocale(Astro.params.locale);
const currency = Astro.locals.currency;
const content = getPageContent(locale);
const [sharedPlans, managedPlans] = await Promise.all([
	getSharedPlansFromDb(locale),
	getManagedPlansFromDb(locale),
]);
---

<Layout locale={locale} currency={currency} title={`${content.shared.title} | VIP Super Hosting`} description={content.shared.description} path={Astro.url.pathname} user={Astro.locals.user}>
	<section class="section hero">
		<div class="container split">
			<div class="card stack">
				<span class="eyebrow">Web Hosting</span>
				<h1>{content.shared.title}</h1>
				<p>{content.shared.description}</p>
			</div>
			<div class="card">
				<ul class="list-clean">
					{content.shared.highlights.map((item: string) => <li>{item}</li>)}
				</ul>
			</div>
		</div>
	</section>
	<FeatureGrid title={content.shared.featureTitle} description={content.shared.description} items={getServiceFeatures(locale).shared} />
	<PricingCards title={content.shared.tiersTitle} description={content.shared.tiersDescription} plans={sharedPlans} currency={currency} ronRate={Astro.locals.ronRate} anchor="plans" />
	<PricingCards title={content.shared.managedTitle} description={content.managed.description} plans={managedPlans} currency={currency} ronRate={Astro.locals.ronRate} />
	<Configurator id="configurator" title={content.shared.configuratorTitle} description={content.shared.configuratorDescription} type="shared-config" locale={locale} />
</Layout>

---
import Layout from '@/components/Layout.astro';
import { normalizeLocale } from '@/lib/i18n';
import { getPageContent } from '@/lib/site';

const locale = normalizeLocale(Astro.params.locale);
const currency = Astro.locals.currency;
const content = getPageContent(locale);
const status = Astro.url.searchParams.get('status');
---

<Layout locale={locale} currency={currency} title={`${content.auth.forgotTitle} | VIP Super Hosting`} description={content.home.description} path={Astro.url.pathname} user={Astro.locals.user}>
	<section class="section">
		<div class="container split">
			<div class="card stack">
				<span class="eyebrow">Account</span>
				<h1>{content.auth.forgotTitle}</h1>
				<p>This MVP stores the request and confirms the flow. Email delivery can be connected once the final mail pipeline is wired.</p>
			</div>
			<form class="card form-grid" method="post" action="/api/session/forgot-password">
				<input type="hidden" name="locale" value={locale} />
				{status && <div class="notice notice--success">Reset request recorded. Continue the email integration when the delivery service is ready.</div>}
				<div class="field"><label for="forgot-email">Email</label><input class="input" id="forgot-email" name="email" type="email" required /></div>
				<button class="button button--primary" type="submit">Request reset</button>
			</form>
		</div>
	</section>
</Layout>

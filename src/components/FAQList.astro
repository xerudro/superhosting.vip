---
const { title, description, items } = Astro.props as {
	title: string;
	description: string;
	items: Array<{ question: string; answer: string }>;
};
---

<section class="section">
	<div class="container">
		<div class="section-head">
			<h2>{title}</h2>
			<p>{description}</p>
		</div>
		<div class="faq-list">
			{items.map((item) => (
				<details class="faq-item">
					<summary>{item.question}</summary>
					<p>{item.answer}</p>
				</details>
			))}
		</div>
	</div>
</section>

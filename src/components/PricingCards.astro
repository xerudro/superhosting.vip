---
import { formatMoney, formatMoneyRaw } from '@/lib/currency';

const { title, description, plans, currency, anchor, ronRate } = Astro.props as {
	title: string;
	description: string;
	plans: import('@/lib/site').PricingPlan[];
	currency: import('@/lib/currency').Currency;
	anchor?: string;
	ronRate?: number;
};
---

<section class="section" id={anchor}>
	<div class="container">
		<div class="section-head">
			<h2>{title}</h2>
			<p>{description}</p>
		</div>
		<div class="grid-3">
			{plans.map((plan) => (
				<article class:list={['pricing-card', plan.accent && 'pricing-card--accent']} data-price={plan.priceEur}>
					<span class="badge">{plan.name}</span>
					<p>{plan.description}</p>
					<div class="pricing-card__price">
						<span class="price-number">{plan.priceCurrency ? formatMoneyRaw(plan.priceEur, plan.priceCurrency) : formatMoney(plan.priceEur, currency, ronRate)}{(plan.priceCurrency ?? currency) === 'RON' && <sup class="price-asterisk">*</sup>}</span>
						<span class="price-suffix">/mo</span>
					</div>
					<ul class="list-clean">
						{plan.features.map((feature) => (
							<li>{feature}</li>
						))}
					</ul>
					<a class="button button--primary" href="#configurator">{plan.cta}</a>
				</article>
			))}
		</div>
	</div>
</section>
